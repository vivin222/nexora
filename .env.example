# NEXORA Environment Configuration
# Backend configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Gemini AI Configuration (Official google-genai SDK)
# Optional: if not provided or API is unreachable, NEXORA gracefully falls back to deterministic local intelligence engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_URL=sqlite:///./nexora.db

# Security
SECRET_KEY=nexora-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
